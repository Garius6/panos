тип Статус = перечисление
Новая
Готовая
конец

тип Задача = структура
название: Строка
статус: Статус
конец

функ вес(задача: Задача) -> Число
выбор задача.статус
Новая -> 1
Готовая -> 10
конец
конец

функ старт() -> Число
пер задачи: Массив(Задача) = массив()
задачи.добавить(Задача("прочитать спецификацию", Статус.Новая))
задачи.добавить(Задача("запустить тесты", Статус.Готовая))

пер сводка: Соответствие(Строка, Число) = соответствие(
"всего" = задачи.длина(),
"готово" = 1,
)

пер сумма = 0
для задача в задачи цикл
сумма = сумма + вес(задача)
конец

сумма + сводка.получить("всего", 0) - сводка.получить("готово", 0)
конец

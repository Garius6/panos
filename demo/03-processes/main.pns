тип Сообщение = перечисление
Добавить(Число, Процесс(Число))
конец

функ счётчик(значение: Число) -> Пусто
выбор получить()
Сообщение.Добавить(дельта, ответ) тогда
пер новое = значение + дельта
отправить(ответ, новое)
счётчик(новое)
конец
конец
конец

функ старт() -> Число
пер worker: Процесс(Сообщение) = запусти счётчик(0)
отправить(worker, Сообщение.Добавить(40, себя()))
пер первое: Число = получить()
отправить(worker, Сообщение.Добавить(2, себя()))
пер второе: Число = получить()
первое + второе - 40
конец

// Первый array-срез AOT object-table: scalar-элементы, append и чтение.
функ старт() -> Число
    пер числа = массив(10.0, 20.0)
    числа[1] = 10.0
    числа.добавить(12.0)
    пер итог = 0.0
    для i = 0 по числа.длина() - 1 цикл
        итог = итог + числа.получить(i, 0.0)
    конец
    итог
конец

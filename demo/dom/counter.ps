импорт DOM
импорт строки

функ на_клик() -> Пусто
    пер текущий = DOM.текст("#count")
    пер число = выбор текущий
        Есть(s) -> s
        Нет -> "0"
    конец
    пер значение = выбор строки.в_число(число)
        Успех(n) -> n
        Неудача(_) -> 0.0
    конец
    DOM.установить_текст("#count", строки.из_числа(значение + 1.0))
конец

функ старт() -> Пусто
    DOM.на_клик("#btn", "на_клик")
конец

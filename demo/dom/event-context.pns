импорт DOM

// `на_клик` принимает настоящее замыкание: строковый id захватывается
// напрямую, а MouseEvent приходит отдельным DOM.СобытиеКлика.
функ показать_задачу(id: Строка) -> Пусто
    DOM.установить_текст_строка("#вывод", "Выбрана задача " + id)
конец

функ после_рендера(_: Строка) -> Пусто
    DOM.установить_текст_строка("#статус", "Готово")
конец

функ старт() -> Пусто
    DOM.создать_и_добавить("#список", "button", "задача-42")
    DOM.установить_текст_строка("#задача-42", "Открыть задачу")
    DOM.на_клик("#задача-42", функ(_: DOM.СобытиеКлика) -> Пусто
        показать_задачу("42")
    конец)
    DOM.после_кадра("после_рендера", "")
конец

функ старт() -> Число
    пер значение = Опция.Есть(42.0)
    выбор значение
        Есть(x) -> x
        Нет -> 0.0
    конец
конец

функ причина() -> Строка
    пер результат: Результат(Число, Строка) = Результат.Неудача("нет")
    выбор результат
        Успех(_) -> ""
        Неудача(ошибка) -> ошибка
    конец
конец

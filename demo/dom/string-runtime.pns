импорт строки

// Проверяет строковые imports AOT: руны, UTF-8-длину, разбиение и
// Результат от строки.в_число. Ожидаемое значение старт() — 13.
функ старт() -> Число
	пер части = строки.разбить("ёж,12", ",")
	пер число = выбор строки.в_число(части.получить(1, "0"))
		Успех(x) -> x
		Неудача(_) -> 0.0
	конец
	пер срез = строки.срез("ёжик", 0, 2)
	если длина("ёж") == 2 и строки.длина_байт("ёж") == 4 и строки.найти(срез, "ж", 0) == 1 и строки.начинается_с(строки.заменить(срез, "ж", "ж"), "ёж") тогда
		число + 1.0
	иначе
		0.0
	конец
конец

// Первый object-table срез AOT: номинальная структура из scalar-полей.
// Массивы, map и ADT намеренно ещё не входят в ABI.
тип Задача = структура
    id: Число
    текст: Строка
    готово: Булево
конец

функ значение_готовой(задача: Задача) -> Число
    если задача.готово тогда
        задача.id
    иначе
        0.0
    конец
конец

функ сдвинуть(задача: Задача) -> Число
    задача.id = задача.id + 1.0
    задача.id
конец

функ старт() -> Число
    сдвинуть(Задача(41.0, "готово", истина))
конец

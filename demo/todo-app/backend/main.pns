импорт "сеть/http" как хттп
импорт "кодирование/json" как json
импорт "коллекции" как кол
импорт строки

// Демо: список задач. Состояние живёт в ОТДЕЛЬНОМ процессе-хранилище
// (Erlang-style "state in a process"), не в top-level переменной —
// panos намеренно не имеет top-level mutable state (см. Recent Changes
// в CLAUDE.md про top-level конст). Маршрутизатор.обслуживать(порт, ...,
// 1) — ОДИН worker-процесс, запросы обрабатываются последовательно, так
// что каждый обработчик может спокойно сделать отправить+получить на
// хранилище без риска перепутать чей-то чужой ответ (реальная проблема
// при процессов>1, вне области демо).

тип Задача = структура
	id:     Число
	текст:  Строка
	готово: Булево
конец

тип СообщениеХранилища = перечисление
	Список(Процесс(Массив(Задача)))
	Добавить(Строка, Процесс(Задача))
	Переключить(Число, Процесс(Опция(Задача)))
	Удалить(Число, Процесс(Булево))
конец

функ хранилище(задачи: Массив(Задача), следующий_id: Число) -> Пусто
	выбор получить()
		СообщениеХранилища.Список(куда) тогда
			отправить(куда, задачи)
			хранилище(задачи, следующий_id)
		конец

		СообщениеХранилища.Добавить(текст, куда) тогда
			пер новая = Задача(следующий_id, текст, ложь)
			задачи.добавить(новая)
			отправить(куда, новая)
			хранилище(задачи, следующий_id + 1.0)
		конец

		СообщениеХранилища.Переключить(id, куда) тогда
			пер найдена: Опция(Задача) = Опция.Нет()
			для t в задачи цикл
				если t.id == id тогда
					t.готово = не t.готово
					найдена = Опция.Есть(t)
				конец
			конец
			отправить(куда, найдена)
			хранилище(задачи, следующий_id)
		конец

		СообщениеХранилища.Удалить(id, куда) тогда
			пер до = задачи.длина()
			пер оставшиеся = кол.отфильтровать(задачи, функ(t: Задача) -> Булево
				t.id <> id
			конец)
			отправить(куда, оставшиеся.длина() <> до)
			хранилище(оставшиеся, следующий_id)
		конец
	конец
конец

функ задача_в_json(t: Задача) -> json.Значение
	json.Значение.Объект(соответствие(
		"id" = json.Значение.Число(t.id),
		"текст" = json.Значение.Строка(t.текст),
		"готово" = json.Значение.Булево(t.готово),
	))
конец

функ ответ_json(значение: json.Значение) -> хттп.ОтветСервера
	хттп.ОтветСервера(200.0, "application/json", json.сериализовать(значение))
конец

функ ответ_ошибка(статус: Число, сообщение: Строка) -> хттп.ОтветСервера
	хттп.ОтветСервера(
		статус,
		"application/json",
		json.сериализовать(json.Значение.Объект(соответствие("ошибка" = json.Значение.Строка(сообщение)))),
	)
конец

функ обработать_список(зм: хттп.ЗапросМаршрута, хр: Процесс(СообщениеХранилища)) -> хттп.ОтветСервера
	отправить(хр, СообщениеХранилища.Список(себя()))
	пер задачи: Массив(Задача) = получить()
	пер элементы = кол.отобразить(задачи, задача_в_json)
	ответ_json(json.Значение.Список(элементы))
конец

функ текст_из_тела(тело: Строка) -> Опция(Строка)
	выбор json.разобрать(тело)
		Успех(значение) тогда
			выбор значение.поле("текст")
				Есть(v) -> v.как_строку()
				Нет -> Опция.Нет()
			конец
		конец
		Неудача(_) тогда
			Опция.Нет()
		конец
	конец
конец

функ обработать_добавить(зм: хттп.ЗапросМаршрута, хр: Процесс(СообщениеХранилища)) -> хттп.ОтветСервера
	выбор текст_из_тела(зм.запрос.тело())
		Есть(текст) тогда
			если строки.длина_байт(текст) == 0 тогда
				ответ_ошибка(400.0, "текст обязателен")
			иначе
				отправить(хр, СообщениеХранилища.Добавить(текст, себя()))
				пер новая: Задача = получить()
				ответ_json(задача_в_json(новая))
			конец
		конец
		Нет -> ответ_ошибка(400.0, "ожидается JSON с полем текст")
	конец
конец

функ обработать_переключить(зм: хттп.ЗапросМаршрута, хр: Процесс(СообщениеХранилища)) -> хттп.ОтветСервера
	пер id_текст = зм.параметры.получить("id", "")
	выбор строки.в_число(id_текст)
		Успех(id) тогда
			отправить(хр, СообщениеХранилища.Переключить(id, себя()))
			пер ответ: Опция(Задача) = получить()
			выбор ответ
				Есть(t) -> ответ_json(задача_в_json(t))
				Нет -> ответ_ошибка(404.0, "задача не найдена")
			конец
		конец
		Неудача(_) тогда
			ответ_ошибка(400.0, "некорректный id")
		конец
	конец
конец

функ обработать_удалить(зм: хттп.ЗапросМаршрута, хр: Процесс(СообщениеХранилища)) -> хттп.ОтветСервера
	пер id_текст = зм.параметры.получить("id", "")
	выбор строки.в_число(id_текст)
		Успех(id) тогда
			отправить(хр, СообщениеХранилища.Удалить(id, себя()))
			пер был: Булево = получить()
			если был тогда
				хттп.ОтветСервера(204.0, "text/plain", "")
			иначе
				ответ_ошибка(404.0, "задача не найдена")
			конец
		конец
		Неудача(_) тогда
			ответ_ошибка(400.0, "некорректный id")
		конец
	конец
конец

функ старт() -> Число
	пер хр: Процесс(СообщениеХранилища) = запусти хранилище(массив(), 1.0)

	пер р = хттп.маршрутизатор()
	р.получить("/api/tasks", функ(зм: хттп.ЗапросМаршрута) -> хттп.ОтветСервера
		обработать_список(зм, хр)
	конец)
	р.отправить_пост("/api/tasks", функ(зм: хттп.ЗапросМаршрута) -> хттп.ОтветСервера
		обработать_добавить(зм, хр)
	конец)
	р.отправить_пост("/api/tasks/:id/toggle", функ(зм: хттп.ЗапросМаршрута) -> хттп.ОтветСервера
		обработать_переключить(зм, хр)
	конец)
	р.удалить("/api/tasks/:id", функ(зм: хттп.ЗапросМаршрута) -> хттп.ОтветСервера
		обработать_удалить(зм, хр)
	конец)

	пер статика = хттп.статический_обработчик(".", "demo/todo-app/frontend/index.html")
	хттп.обслуживать(18321.0, функ(запрос: Запрос) -> хттп.ОтветСервера
		если строки.начинается_с(запрос.путь(), "/api/") тогда
			р.обработать(запрос)
		иначе
			статика(запрос)
		конец
	конец, 1.0).ожидать("не смог слушать")
конец

импорт DOM
импорт состояние
импорт "сеть" как сеть
импорт строки

// AOT-фронтенд todo: DOM, строки, массивы, структуры, Опция/Результат и
// сеть.http_запрос_sync работают через browser runtime. HTTP выполняется
// синхронным same-origin XHR: это осознанный bridge до появления CPS для
// асинхронного fetch и акторов.
//
// AOT build уже умеет связать локальные panos-модули, но это демо намеренно
// самодостаточно: ручной разбор рассчитан только на плоский JSON API
// бэкенда. Он не является полноценным JSON-парсером и не обрабатывает
// экранированные кавычки внутри текста задачи.
//
// Список задач сам по себе БЕЗ клиентского состояния — источник истины
// всегда бэкенд, перерисовать() каждый раз загружает список заново. Но
// текущий фильтр (все/активные/готово) — чисто клиентское UI-состояние,
// которому НЕЧЕГО делать на сервере. Демонстрирует состояние.прочитать/
// .записать (см. project_panos_elm_architecture_dom_storage_design) —
// Model держится JS-загрузчиком между отдельными обработчиками кликов,
// а не в WASM (WASM не переживает вызов) и не в DOM-атрибуте (раньше
// рассматривался такой вариант, отклонён — DOM для рендера, не для
// хранения).

тип Задача = структура
	id:     Число
	текст:  Строка
	готово: Булево
конец

// извлечь_строковое_поле/извлечь_числовое_поле/извлечь_булево_поле —
// ищут `"ключ":` внутри ОДНОГО JSON-объекта (без внешних []) и читают
// значение после него: строковое — до следующей неэкранированной ",
// числовое/булево — до следующей "," или "}".
функ извлечь_сырое_значение(объект: Строка, ключ: Строка) -> Опция(Строка)
	// строки.найти — РУНОВЫЙ индекс (pw_string_find_rune), а не байтовый
	// — реальный, найденный запуском баг: срез_байт/длина_байт с рунными
	// индексами от найти() смешивали байтовую и рунную адресацию,
	// корёжа кириллический текст ("купить хлеб" резалось посреди
	// символа). Везде ниже — ТОЛЬКО рунные строки.срез/.длина().
	пер маркер = "\"" + ключ + "\":"
	пер позиция = строки.найти(объект, маркер, 0)
	если позиция < 0 тогда
		Опция.Нет()
	иначе
		пер начало = позиция + длина(маркер)
		пер остаток = строки.срез(объект, начало, длина(объект))
		если строки.начинается_с(остаток, "\"") тогда
			пер без_кавычки = строки.срез(остаток, 1, длина(остаток))
			пер конец_строки = строки.найти(без_кавычки, "\"", 0)
			если конец_строки < 0 тогда
				Опция.Нет()
			иначе
				Опция.Есть(строки.срез(без_кавычки, 0, конец_строки))
			конец
		иначе
			// строки.разбить(тело, "},{") СЪЕДАЕТ закрывающую скобку у
			// НЕ-последнего элемента списка (граница-разделитель
			// поглощает оба соседних символа) — если ни "," ни "}" не
			// нашлись, остаток строки ЦЕЛИКОМ — значение (последнее
			// поле объекта, чья "}" была съедена разбиением). Реальный
			// баг, найденный запуском, не гипотезой — граница=-1 давала
			// Опция.Нет() для "готово" у всех элементов КРОМЕ
			// последнего в присланном списке.
			пер запятая = строки.найти(остаток, ",", 0)
			пер скобка = строки.найти(остаток, "}", 0)
			пер граница: Целое = длина(остаток)
			если запятая >= 0 и (скобка < 0 или запятая < скобка) тогда
				граница = запятая
			иначе
				если скобка >= 0 тогда
					граница = скобка
				конец
			конец
			Опция.Есть(строки.срез(остаток, 0, граница))
		конец
	конец
конец

функ разобрать_задачу(объект: Строка) -> Опция(Задача)
	пер id_текст = выбор извлечь_сырое_значение(объект, "id")
		Есть(s) -> s
		Нет -> ""
	конец
	пер текст = выбор извлечь_сырое_значение(объект, "текст")
		Есть(s) -> s
		Нет -> ""
	конец
	пер готово_текст = выбор извлечь_сырое_значение(объект, "готово")
		Есть(s) -> s
		Нет -> ""
	конец
	выбор строки.в_число(id_текст)
		Успех(id) -> Опция.Есть(Задача(id, текст, готово_текст == "true"))
		Неудача(_) -> Опция.Нет()
	конец
конец

// разобрать_список — режет JSON-массив на отдельные объекты по "},{"
// (безопасно ТОЛЬКО потому, что текст задачи не может содержать
// буквальную подстроку "},{" в этом демо — известное упрощение).
функ разобрать_список(тело: Строка) -> Массив(Задача)
	пер результат: Массив(Задача) = массив()
	пер очищено = строки.заменить(строки.заменить(тело, "[", ""), "]", "")
	если строки.длина_байт(очищено) == 0 тогда
		результат
	иначе
		пер части = строки.разбить(очищено, "},{")
		пер n = части.длина()
		// Индексный диапазон делает порядок рендеринга и тип элемента
		// явными для AOT lowering.
		если n > 0 тогда
			для i = 0 по n - 1 цикл
				пер часть = части.получить(i, "")
				пер op = разобрать_задачу(часть)
				если op.есть() тогда
					результат.добавить(op.получить(Задача(0.0, "", ложь)))
				конец
			конец
		конец
		результат
	конец
конец

функ экранировать_json(текст: Строка) -> Строка
	строки.заменить(строки.заменить(текст, "\\", "\\\\"), "\"", "\\\"")
конец

функ загрузить_список() -> Массив(Задача)
	// массив() без аннотации не выводится ВНУТРИ arm'а выбор, даже когда
	// функция объявляет -> Массив(Задача) явно (реальный, найденный
	// пробел типизатора, не гипотеза) — обходим явной аннотацией на
	// пер-привязке.
	пер пусто: Массив(Задача) = массив()
	выбор сеть.http_запрос_sync("GET", "/api/tasks", "")
		Есть(тело) -> разобрать_список(тело)
		Нет -> пусто
	конец
конец

функ отрисовать_задачу(t: Задача) -> Пусто
	пер id_текст = строки.из_числа(t.id)
	пер строка_id = "#задача-" + id_текст
	DOM.создать_и_добавить("#список", "li", "задача-" + id_текст)
	DOM.установить_атрибут(строка_id, "class", если t.готово тогда "задача задача-готово" иначе "задача" конец)

	// Обработчик захватывает id напрямую как Число; параметр события здесь
	// не нужен, но остаётся частью единой сигнатуры DOM.на_клик.
	пер id: Число = t.id

	DOM.создать_и_добавить(строка_id, "span", "флажок-" + id_текст)
	DOM.установить_атрибут("#флажок-" + id_текст, "class", "флажок")
	DOM.установить_текст_строка("#флажок-" + id_текст, если t.готово тогда "✓" иначе "" конец)
	DOM.на_клик("#флажок-" + id_текст, функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_переключить(id)
	конец)

	DOM.создать_и_добавить(строка_id, "span", "текст-" + id_текст)
	DOM.установить_атрибут("#текст-" + id_текст, "class", "задача-текст")
	DOM.установить_текст_строка("#текст-" + id_текст, t.текст)

	DOM.создать_и_добавить(строка_id, "button", "удалить-" + id_текст)
	DOM.установить_атрибут("#удалить-" + id_текст, "class", "кнопка-удалить")
	DOM.установить_текст_строка("#удалить-" + id_текст, "✕")
	DOM.на_клик("#удалить-" + id_текст, функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_удалить(id)
	конец)
конец

функ показывать(t: Задача, фильтр: Строка) -> Булево
	если фильтр == "активные" тогда
		не t.готово
	иначе
		если фильтр == "готово" тогда
			t.готово
		иначе
			истина
		конец
	конец
конец

функ класс_фильтра(активен: Булево) -> Строка
	если активен тогда
		"фильтр фильтр-активен"
	иначе
		"фильтр"
	конец
конец

функ перерисовать() -> Пусто
	DOM.установить_текст_строка("#список", "")
	пер фильтр = состояние.прочитать()
	DOM.установить_атрибут("#фильтр-все", "class", класс_фильтра(фильтр == "все"))
	DOM.установить_атрибут("#фильтр-активные", "class", класс_фильтра(фильтр == "активные"))
	DOM.установить_атрибут("#фильтр-готово", "class", класс_фильтра(фильтр == "готово"))
	пер задачи = загрузить_список()
	пер n = задачи.длина()
	если n > 0 тогда
		для i = 0 по n - 1 цикл
			пер t = задачи.получить(i, Задача(0.0, "", ложь))
			если показывать(t, фильтр) тогда
				отрисовать_задачу(t)
			конец
		конец
	конец
конец

функ обработать_фильтр(контекст: Строка) -> Пусто
	состояние.записать(контекст)
	перерисовать()
конец

функ обработать_добавить() -> Пусто
	пер текст = DOM.значение_поля("#новая-задача")
	если строки.длина_байт(текст) == 0 тогда
		перерисовать()
	иначе
		пер тело = "{\"текст\":\"" + экранировать_json(текст) + "\"}"
		сеть.http_запрос_sync("POST", "/api/tasks", тело)
		DOM.установить_значение_поля("#новая-задача", "")
		перерисовать()
	конец
конец

функ обработать_переключить(id: Число) -> Пусто
	сеть.http_запрос_sync("POST", "/api/tasks/" + строки.из_числа(id) + "/toggle", "")
	перерисовать()
конец

функ обработать_удалить(id: Число) -> Пусто
	сеть.http_запрос_sync("DELETE", "/api/tasks/" + строки.из_числа(id), "")
	перерисовать()
конец

функ старт() -> Пусто
	состояние.записать("все")
	DOM.на_клик("#добавить", функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_добавить()
	конец)
	DOM.на_клик("#фильтр-все", функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_фильтр("все")
	конец)
	DOM.на_клик("#фильтр-активные", функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_фильтр("активные")
	конец)
	DOM.на_клик("#фильтр-готово", функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_фильтр("готово")
	конец)
	перерисовать()
конец

импорт "коллекции" как кол

функ старт() -> Булево
	пер числа = массив(5.0, 3.0, 8.0, 1.0, 9.0, 2.0)
	пер большие = кол.отфильтровать(числа, функ(x: Число) -> Булево x > 4.0 конец)
	пер удвоенные = кол.отобразить(числа, функ(x: Число) -> Число x * 2.0 конец)
	пер сумма = кол.свернуть(числа, 0.0, функ(накопитель: Число, x: Число) -> Число накопитель + x конец)
	пер отсортированные = кол.отсортировать(числа, функ(а: Число, б: Число) -> Булево а < б конец)

	большие.длина() == 3 и большие[0] == 5.0 и большие[1] == 8.0 и большие[2] == 9.0 и удвоенные[0] == 10.0 и удвоенные[5] == 4.0 и сумма == 28.0 и отсортированные[0] == 1.0 и отсортированные[5] == 9.0
конец

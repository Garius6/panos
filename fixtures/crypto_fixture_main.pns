импорт криптография

функ старт() -> Булево
	пер сиг1 = криптография.hmac_sha256_base64url("секрет", "сообщение")
	пер сиг2 = криптография.hmac_sha256_base64url("секрет", "сообщение")
	пер сиг3 = криптография.hmac_sha256_base64url("другой-секрет", "сообщение")
	пер провал1 = сиг1 <> сиг2
	пер провал2 = сиг1 == сиг3

	пер закодировано = криптография.base64url_кодировать("{\"sub\":\"пользователь\"}")
	пер провал3 = длина(закодировано) == 0

	пер декодировано_рез = криптография.base64url_декодировать(закодировано)
	пер провал4 = декодировано_рез.ошибка() или декодировано_рез.значение() <> "{\"sub\":\"пользователь\"}"

	пер провал5 = не криптография.base64url_декодировать("не-валидный-!!!base64").ошибка()

	пер провал6 = не криптография.сравнить_константное_время(сиг1, сиг2)
	пер провал7 = криптография.сравнить_константное_время(сиг1, сиг3)
	пер провал8 = криптография.сравнить_константное_время(сиг1, "короче")

	пер хэш1 = криптография.sha256_base64url("code_verifier")
	пер хэш2 = криптография.sha256_base64url("code_verifier")
	пер хэш3 = криптография.sha256_base64url("другой-verifier")
	пер провал9 = хэш1 <> хэш2
	пер провал10 = хэш1 == хэш3
	пер провал11 = хэш1 == сиг1

	пер пароль1 = криптография.pbkdf2_sha256_base64url("пароль123", "соль", 1000.0)
	пер пароль2 = криптография.pbkdf2_sha256_base64url("пароль123", "соль", 1000.0)
	пер пароль3 = криптография.pbkdf2_sha256_base64url("другой-пароль", "соль", 1000.0)
	пер пароль4 = криптография.pbkdf2_sha256_base64url("пароль123", "другая-соль", 1000.0)
	пер провал12 = пароль1 <> пароль2
	пер провал13 = пароль1 == пароль3
	пер провал14 = пароль1 == пароль4

	не (провал1 или провал2 или провал3 или провал4 или провал5 или провал6 или провал7 или провал8 или провал9 или провал10 или провал11 или провал12 или провал13 или провал14)
конец

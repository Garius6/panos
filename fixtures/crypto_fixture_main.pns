импорт крипто

функ старт() -> Булево
	пер сиг1 = крипто.hmac_sha256_base64url("секрет", "сообщение")
	пер сиг2 = крипто.hmac_sha256_base64url("секрет", "сообщение")
	пер сиг3 = крипто.hmac_sha256_base64url("другой-секрет", "сообщение")
	пер провал1 = сиг1 <> сиг2
	пер провал2 = сиг1 == сиг3

	пер закодировано = крипто.base64url_кодировать("{\"sub\":\"пользователь\"}")
	пер провал3 = длина(закодировано) == 0

	пер декодировано_рез = крипто.base64url_декодировать(закодировано)
	пер провал4 = декодировано_рез.ошибка() или декодировано_рез.значение() <> "{\"sub\":\"пользователь\"}"

	пер провал5 = не крипто.base64url_декодировать("не-валидный-!!!base64").ошибка()

	пер провал6 = не крипто.сравнить_константное_время(сиг1, сиг2)
	пер провал7 = крипто.сравнить_константное_время(сиг1, сиг3)
	пер провал8 = крипто.сравнить_константное_время(сиг1, "короче")

	не (провал1 или провал2 или провал3 или провал4 или провал5 или провал6 или провал7 или провал8)
конец

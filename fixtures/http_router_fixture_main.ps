импорт "сеть/http" как хттп

функ проверить_точное_совпадение() -> Булево
	пер совпадение = хттп.сопоставить_путь("/пользователи", "/пользователи")
	не совпадение.есть()
конец

функ проверить_несовпадение_по_числу_сегментов() -> Булево
	пер совпадение = хттп.сопоставить_путь("/пользователи", "/пользователи/42")
	совпадение.есть()
конец

функ проверить_несовпадение_литерала() -> Булево
	пер совпадение = хттп.сопоставить_путь("/пользователи/:id", "/заказы/42")
	совпадение.есть()
конец

функ проверить_извлечение_параметра() -> Булево
	пер совпадение = хттп.сопоставить_путь("/пользователи/:id", "/пользователи/42")
	если не совпадение.есть() тогда
		возврат истина // ожидалось совпадение, не совпало — провал
	конец
	пер параметры = совпадение.получить(соответствие())
	параметры.получить("id", "") <> "42"
конец

функ проверить_несколько_параметров() -> Булево
	пер совпадение = хттп.сопоставить_путь("/пользователи/:id/заказы/:заказ_id", "/пользователи/7/заказы/99")
	если не совпадение.есть() тогда
		возврат истина // ожидалось совпадение, не совпало — провал
	конец
	пер параметры = совпадение.получить(соответствие())
	пер провал1 = параметры.получить("id", "") <> "7"
	пер провал2 = параметры.получить("заказ_id", "") <> "99"
	провал1 или провал2
конец

// Ведущий/конечный "/" не должен создавать пустой сегмент ни у шаблона,
// ни у реального пути (разбить_путь используется с обеих сторон
// одинаково) — иначе число сегментов ложно разошлось бы.
функ проверить_конечный_слэш() -> Булево
	пер совпадение = хттп.сопоставить_путь("/пользователи/:id", "/пользователи/42/")
	не совпадение.есть()
конец

функ проверить_корень() -> Булево
	пер совпадение = хттп.сопоставить_путь("/", "/")
	не совпадение.есть()
конец

функ старт() -> Булево
	пер провал1 = проверить_точное_совпадение()
	пер провал2 = проверить_несовпадение_по_числу_сегментов()
	пер провал3 = проверить_несовпадение_литерала()
	пер провал4 = проверить_извлечение_параметра()
	пер провал5 = проверить_несколько_параметров()
	пер провал6 = проверить_конечный_слэш()
	пер провал7 = проверить_корень()
	не (провал1 или провал2 или провал3 или провал4 или провал5 или провал6 или провал7)
конец

импорт "сеть/http" как хттп

функ показать_пользователя(зм: хттп.ЗапросМаршрута) -> хттп.ОтветСервера
	пер id = зм.параметры.получить("id", "")
	хттп.ОтветСервера(200, "text/plain", "пользователь:" + id)
конец

функ старт() -> Число
	пер р = хттп.маршрутизатор()
	р.получить("/пользователи/:id", показать_пользователя)
	хттп.обслуживать(18191, р.как_обработчик(), 1).ожидать("не смог слушать")
конец

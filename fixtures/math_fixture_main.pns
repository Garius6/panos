импорт математика

функ старт() -> Булево
	пер квадрат = математика.квадрат(6.0)
	пер минимум = математика.мин(3.0, 7.0)
	пер максимум = математика.макс(3.0, 7.0)
	пер модуль = математика.абс(0.0 - 5.0)
	пер степень = математика.степень(2.0, 10.0)
	пер обратная_степень = математика.степень(2.0, -2.0)
	пер корень = математика.квадратный_корень(144.0)

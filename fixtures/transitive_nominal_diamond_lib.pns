импорт "transitive_nominal_diamond_dep.pns" как dep

/// Псевдоним функционального типа, чей результат — номинальный тип
/// (dep.Значение), объявленный в ТРЕТЬЕМ модуле — сам этот файл
/// импортирует dep напрямую, поэтому dep.Значение попадает в
/// `resolution.imported_symbols` этого модуля обычным путём.
экспорт тип Функция = функ(Целое) -> dep.Значение

экспорт тип Обёртка = структура
	элементы: Массив(Функция)
конец

экспорт функ обёртка() -> Обёртка
	Обёртка(массив())
конец

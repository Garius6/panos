импорт слог
импорт фс
импорт строки

// Абсолютные пути в /tmp (не в репозитории — панос-фс не умеет удалять
// отдельные файлы, только директории целиком, см. фс.удалить_директорию;
// оставлять мусор в дереве репозитория недопустимо, /tmp — стандартное
// место для этого и так). Разные имена на каждую проверку — фс.открыть
// не гарантирует truncate-при-повторном-открытии, переиспользование
// одного файла между независимыми проверками могло бы дать ложное
// совпадение содержимого от предыдущей проверки.

// Уровень фильтрации: приёмник получает только Сбой/Критично (порог —
// Сбой), Отладка/Инфо/Предупреждение обязаны быть подавлены ДО того,
// как дойдут до приёмника.
функ проверить_фильтрацию_по_уровню() -> Булево
	пер путь = "/tmp/panos_logger_fixture_level.log"
	пер приёмник = слог.приёмник_файл(путь).ожидать("не смог открыть лог")
	пер л = слог.логгер().с_уровнем(слог.Уровень.Сбой).с_приёмником(приёмник)
	л.отладка("должно быть подавлено")
	л.инфо("должно быть подавлено")
	л.предупреждение("должно быть подавлено")
	л.ошибка("должно пройти")

	пер содержимое = фс.прочитать(путь).получить("(не прочиталось)")
	пер провал1 = строки.содержит(содержимое, "должно быть подавлено")
	пер провал2 = не строки.содержит(содержимое, "должно пройти")
	не (провал1 или провал2)
конец

// Тег — префикс "[имя]" в каждой строке, независимо от уровня.
функ проверить_тег() -> Булево
	пер путь = "/tmp/panos_logger_fixture_tag.log"
	пер приёмник = слог.приёмник_файл(путь).ожидать("не смог открыть лог")
	пер л = слог.логгер().с_тегом("http").с_приёмником(приёмник)
	л.инфо("проверка тега")

	пер содержимое = фс.прочитать(путь).получить("")
	строки.содержит(содержимое, "[http]")
конец

// Структурные поля сериализуются как "ключ=значение" через пробел после
// основного текста.
функ проверить_структурные_поля() -> Булево
	пер путь = "/tmp/panos_logger_fixture_fields.log"
	пер приёмник = слог.приёмник_файл(путь).ожидать("не смог открыть лог")
	пер л = слог.логгер().с_приёмником(приёмник)
	л.запись_с_полями(слог.Уровень.Инфо, "запрос обработан", соответствие("путь" = "/тест", "статус" = "200"))

	пер содержимое = фс.прочитать(путь).получить("")
	строки.содержит(содержимое, "путь=/тест") и строки.содержит(содержимое, "статус=200")
конец

// Несколько приёмников — логгер() уже даёт приёмник_консоль по
// умолчанию, .с_приёмником ДОБАВЛЯЕТ файловый, не заменяет — файл
// обязан получить запись независимо от того, что консоль тоже её
// получила (консоль здесь не проверяется — только не должна упасть).
функ проверить_несколько_приёмников() -> Булево
	пер путь = "/tmp/panos_logger_fixture_multi.log"
	пер файловый = слог.приёмник_файл(путь).ожидать("не смог открыть лог")
	пер л = слог.логгер().с_приёмником(файловый)
	л.инфо("в оба приёмника")

	пер содержимое = фс.прочитать(путь).получить("")
	строки.содержит(содержимое, "в оба приёмника")
конец

функ старт() -> Булево
	пер провал1 = не проверить_фильтрацию_по_уровню()
	пер провал2 = не проверить_тег()
	пер провал3 = не проверить_структурные_поля()
	пер провал4 = не проверить_несколько_приёмников()
	не (провал1 или провал2 или провал3 или провал4)
конец

импорт строки

// Общая backslash-escape логика для json.ps/toml.ps: обе спецификации
// разделяют идентичный базовый набор (\" \\ \n \t \r). TOML сверху
// экранирует управляющие байты < 0x20 через \u00XX (json.ps исторически
// этого не делал — параметр экранировать_управляющие сохраняет ЭТО же
// поведение для обоих вызывающих без изменений, это чистый dedup, не
// исправление покрытия JSON-спеки — см. аудит техдолга 2026-07-27).
// Раньше — идентичные ~25 строк, продублированные в обоих файлах.

функ цифра_в_hex(n: Целое) -> Строка
	если n == 0 тогда возврат "0" конец
	если n == 1 тогда возврат "1" конец
	если n == 2 тогда возврат "2" конец
	если n == 3 тогда возврат "3" конец
	если n == 4 тогда возврат "4" конец
	если n == 5 тогда возврат "5" конец
	если n == 6 тогда возврат "6" конец
	если n == 7 тогда возврат "7" конец
	если n == 8 тогда возврат "8" конец
	если n == 9 тогда возврат "9" конец
	если n == 10 тогда возврат "a" конец
	если n == 11 тогда возврат "b" конец
	если n == 12 тогда возврат "c" конец
	если n == 13 тогда возврат "d" конец
	если n == 14 тогда возврат "e" конец
	"f"
конец

/// Экранирует "\\, \", \\n, \\t, \\r во всех случаях; управляющие байты
/// < 0x20 (кроме уже перечисленных) — только если экранировать_управляющие.
экспорт функ экранировать_базовое(текст: Строка, экранировать_управляющие: Булево) -> Строка
	пер результат = ""
	пер i: Целое = 0
	пер n = длина(текст)
	пока i < n цикл
		пер символ = текст[i]
		пер добавка = символ
		если символ == "\"" тогда
			добавка = "\\\""
		конец
		если символ == "\\" тогда
			добавка = "\\\\"
		конец
		если символ == "\n" тогда
			добавка = "\\n"
		конец
		если символ == "\t" тогда
			добавка = "\\t"
		конец
		если символ == "\r" тогда
			добавка = "\\r"
		конец
		если экранировать_управляющие и символ <> "\"" и символ <> "\\" и символ <> "\n" и символ <> "\t" и символ <> "\r" и строки.байт(символ, 0) < 32 тогда
			пер код = строки.байт(символ, 0)
			добавка = "\\u00" + цифра_в_hex(код / 16) + цифра_в_hex(код % 16)
		конец
		результат = результат + добавка
		i = i + 1
	конец
	результат
конец

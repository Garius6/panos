импорт "ввод_вывод" как ио
импорт фс
импорт время
импорт строки
импорт математика

экспорт функ отладка(текст: Строка) -> Пусто
	ио.строка("[ОТЛАДКА] " + текст)
конец

экспорт функ инфо(текст: Строка) -> Пусто
	ио.строка("[ИНФО] " + текст)
конец

экспорт функ предупреждение(текст: Строка) -> Пусто
	ио.строка("[ПРЕДУПРЕЖДЕНИЕ] " + текст)
конец

экспорт функ ошибка(текст: Строка) -> Пусто
	ио.строка("[ОШИБКА] " + текст)
конец

экспорт функ критично(текст: Строка) -> Пусто
	ио.строка("[КРИТИЧНО] " + текст)
конец

// ЛОГГЕР. Функции выше остаются как есть (безусловная печать в stdout,
// без фильтрации/тегов) — простой случай не должен требовать ничего
// сверх `слог.инфо(текст)`. Всё ниже — для случаев, когда нужен уровень
// фильтрации, теги по компоненту, несколько приёмников или структурные
// поля.
//
// Логгер — ОБЫЧНАЯ структура с явным состоянием (минимальный уровень,
// тег, список приёмников), пробрасываемая вызывающим кодом — panos не
// хранит модульных глобальных переменных (нет механизма для этого
// вообще, `конст` — compile-time подстановка, не рантайм-ячейка, см.
// core/parser.odin:1121-1125), к тому же actor-модель (`запусти`)
// кооперативно шарит один VM/heap между процессами — скрытая глобальная
// мутируемая настройка была бы неохраняемым бэкдором общей памяти в
// обход message-passing изоляции. Тот же паттерн явного состояния уже
// есть у `математика.Генератор` (явный seed вместо скрытого PRNG-стейта).

/// Уровень логирования — используется и для фильтрации (Логгер.
/// минимальный_уровень), и для префикса строки. Не `Ошибка` (не `Сбой`
/// вместо него) — `Ошибка` уже зарезервировано под встроенный тип
/// ошибки (`Результат(T, Ошибка)`), вариант перечисления с этим именем
/// конфликтует с ним на уровне резолвера.
экспорт тип Уровень = перечисление
	Отладка
	Инфо
	Предупреждение
	Сбой
	Критично
конец

// Целочисленный ранг для сравнения уровней — Уровень сам не Сравниваемое
// (перечисление без данных, `<` для него не имеет смысла в общем случае
// в panos), поэтому фильтрация сравнивает ранги напрямую. Число, не
// Целое — литералы веток `выбор` НЕ сужаются автоматически до Целое
// (widening литералов работает только для трейлинг-выражения самого
// тела функции, не рекурсивно внутрь match-веток), Число здесь ничем не
// хуже для сравнения `<`.
функ ранг(у: Уровень) -> Число
	выбор у
		Отладка -> 0
		Инфо -> 1
		Предупреждение -> 2
		Сбой -> 3
		Критично -> 4
	конец
конец

функ префикс_уровня(у: Уровень) -> Строка
	выбор у
		Отладка -> "ОТЛАДКА"
		Инфо -> "ИНФО"
		Предупреждение -> "ПРЕДУПРЕЖДЕНИЕ"
		Сбой -> "ОШИБКА"
		Критично -> "КРИТИЧНО"
	конец
конец

/// Куда уходит уже готовая (отформатированная) строка лога — обычная
/// функция-значение, не закрытый список видов: можно передать СВОЙ
/// приёмник (например, отправку в другую систему), не только встроенные
/// приёмник_консоль/приёмник_файл ниже.
экспорт тип Приёмник = функ(Строка) -> Пусто

/// Приёмник, печатающий в stdout (`ввод_вывод.строка`).
экспорт функ приёмник_консоль() -> Приёмник
	функ(строка: Строка) -> Пусто
		ио.строка(строка)
	конец
конец

// фс.открыть открывает файл на чтение И запись (создаёт, если не было),
// но НЕ гарантирует режим "всегда добавлять в конец" сам по себе —
// последовательные .записать() НА УЖЕ ОТКРЫТОМ дескрипторе идут одна за
// другой корректно (файл открывается здесь ОДИН РАЗ, на весь срок жизни
// приёмника), но повторный ЗАПУСК ПРОГРАММЫ с уже существующим файлом
// лога может начать перезаписывать байты с начала, а не гарантированно
// добавлять в конец — то же ограничение, что у фс.открыть в целом (см.
// «Ввод-вывод и файловая система»), не что-то специфичное для слог.
/// Приёмник, дозаписывающий в файл (открытый один раз при создании).
/// Недоступно в WASM-демо (как и весь `фс`).
экспорт функ приёмник_файл(путь: Строка) -> Результат(Приёмник, Ошибка)
	пер файл_рез = фс.открыть(путь)
	если файл_рез.ошибка() тогда
		возврат Результат.Неудача(файл_рез.причина())
	конец
	пер файл = файл_рез.значение()
	Результат.Успех(функ(строка: Строка) -> Пусто
		файл.записать(строка + "\n")
	конец)
конец

/// Логгер — минимальный уровень (фильтрация), тег (компонент/подсистема)
/// и список приёмников (пишет во ВСЕ сразу).
экспорт тип Логгер = структура
	минимальный_уровень: Уровень
	тег:                 Строка
	приёмники:           Массив(Приёмник)
конец

/// Логгер по умолчанию: печатает всё (Отладка и выше) в консоль, без тега.
экспорт функ логгер() -> Логгер
	пер приёмники: Массив(Приёмник) = массив()
	приёмники.добавить(приёмник_консоль())
	Логгер(Уровень.Отладка, "", приёмники)
конец

функ собрать_поля(поля: Соответствие(Строка, Строка)) -> Строка
	пер записи = поля.записи()
	пер результат = ""
	пер i: Целое = 0
	пока i < длина(записи) цикл
		пер запись = записи.получить(i, ("", ""))
		результат = результат + " " + запись.0 + "=" + запись.1
		i = i + 1
	конец
	результат
конец

// строки.из_числа(x) форматирует ЛЮБОЕ x с более чем ~6 значащими
// цифрами в scientific notation (fmt.tprintf("%v", f64) в Odin, core/
// vm.odin:1377) — время.сейчас_мс() (~13 цифр) вышло бы как
// "1.785154e+12", нечитаемо как временная метка. Собираем строку сами
// по одной цифре (0-9 — единственный диапазон, для которого из_числа
// гарантированно не переключается на scientific notation).
функ целое_в_строку(x: Число) -> Строка
	пер n = математика.округл_вниз(x)
	если n == 0 тогда
		возврат "0"
	конец
	пер результат = ""
	пока n > 0 цикл
		пер частное = математика.округл_вниз(n / 10)
		пер цифра = n - частное * 10
		результат = строки.из_числа(цифра) + результат
		n = частное
	конец
	результат
конец

реализация Логгер
	/// Копия с другим минимальным уровнем — записи ниже него становятся
	/// no-op (проверка ДО форматирования строки/похода в приёмники).
	функ с_уровнем(это: Логгер, минимальный: Уровень) -> Логгер
		Логгер(минимальный, это.тег, это.приёмники)
	конец

	/// Копия с тегом компонента ("http" -> "[http]" в каждой строке).
	/// Заменяет прежний тег, если был — теги не вкладываются друг в друга.
	/// Не "для" — зарезервированное слово (`для x в ... цикл`).
	функ с_тегом(это: Логгер, тег: Строка) -> Логгер
		Логгер(это.минимальный_уровень, тег, это.приёмники)
	конец

	/// Копия с добавленным приёмником (не заменяет существующие).
	функ с_приёмником(это: Логгер, приёмник: Приёмник) -> Логгер
		пер новые: Массив(Приёмник) = массив()
		для п в это.приёмники цикл
			новые.добавить(п)
		конец
		новые.добавить(приёмник)
		Логгер(это.минимальный_уровень, это.тег, новые)
	конец

	// Временная метка — сырой epoch-миллисекунды (время.сейчас_мс()), НЕ
	// человекочитаемый календарный формат "2026-07-27 12:34:56": в
	// стандартной библиотеке panos нет функции epoch->календарная дата
	// (только время.сейчас_мс()/монотонно_мс()), а писать свою
	// date-математику (високосные годы, часовые пояса) — риск тихих
	// ошибок вне объёма этой правки.
	функ запись(это: Логгер, у: Уровень, текст: Строка) -> Пусто
		если ранг(у) < ранг(это.минимальный_уровень) тогда
			возврат
		конец
		пер тег_часть = ""
		если длина(это.тег) > 0 тогда
			тег_часть = "[" + это.тег + "]"
		конец
		пер метка = "[" + целое_в_строку(время.сейчас_мс()) + "]"
		пер строка = метка + тег_часть + "[" + префикс_уровня(у) + "] " + текст
		для п в это.приёмники цикл
			п(строка)
		конец
	конец

	/// Как .запись, но добавляет структурные поля ("ключ=значение" через
	/// пробел после текста) — удобно для машинно-парсируемых логов.
	функ запись_с_полями(это: Логгер, у: Уровень, текст: Строка, поля: Соответствие(Строка, Строка)) -> Пусто
		это.запись(у, текст + собрать_поля(поля))
	конец

	функ отладка(это: Логгер, текст: Строка) -> Пусто
		это.запись(Уровень.Отладка, текст)
	конец

	функ инфо(это: Логгер, текст: Строка) -> Пусто
		это.запись(Уровень.Инфо, текст)
	конец

	функ предупреждение(это: Логгер, текст: Строка) -> Пусто
		это.запись(Уровень.Предупреждение, текст)
	конец

	функ ошибка(это: Логгер, текст: Строка) -> Пусто
		это.запись(Уровень.Сбой, текст)
	конец

	функ критично(это: Логгер, текст: Строка) -> Пусто
		это.запись(Уровень.Критично, текст)
	конец
конец

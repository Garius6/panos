импорт бд
импорт ввод_вывод как ио
импорт фс

функ старт() -> Пусто
	пер путь = "/tmp/panos_test_sqlite.db"
	фс.удалить(путь)

	пер соед_рез = бд.открыть(путь)
	если соед_рез.ошибка() тогда
		ио.строка("ошибка открытия: \(соед_рез.причина().сообщение)")
		возврат
	конец
	пер соед = соед_рез.значение()

	пер создание = соед.выполнить("CREATE TABLE пользователи (id INTEGER, имя TEXT, возраст INTEGER)", массив())
	если создание.ошибка() тогда
		ио.строка("ошибка создания таблицы: \(создание.причина().сообщение)")
		возврат
	конец
	ио.строка("таблица создана")

	соед.выполнить("INSERT INTO пользователи VALUES (?, ?, ?)", массив("1", "Алиса", "30")).ожидать("insert 1")
	соед.выполнить("INSERT INTO пользователи VALUES (?, ?, ?)", массив("2", "Борис", "25")).ожидать("insert 2")
	соед.выполнить("INSERT INTO пользователи VALUES (?, NULL, ?)", массив("3", "40")).ожидать("insert 3")
	ио.строка("3 строки вставлены")

	пер строки_рез = соед.запрос("SELECT id, имя, возраст FROM пользователи ORDER BY id", массив())
	если строки_рез.ошибка() тогда
		ио.строка("ошибка запроса: \(строки_рез.причина().сообщение)")
		возврат
	конец
	пер строки = строки_рез.значение()

	ио.строка("получено строк: \(строки.длина())")
	для строка в строки цикл
		пер id = строка.получить("id", "?")
		пер возраст = строка.получить("возраст", "?")
		если строка.есть("имя") тогда
			ио.строка("  id=\(id) имя=\(строка.получить("имя", "?")) возраст=\(возраст)")
		иначе
			ио.строка("  id=\(id) имя=NULL возраст=\(возраст)")
		конец
	конец

	пер плохой = соед.выполнить("НЕ ВАЛИДНЫЙ SQL", массив())
	если плохой.ошибка() тогда
		ио.строка("ожидаемая ошибка синтаксиса: \(плохой.причина().сообщение)")
	конец

	соед.закрыть()
	фс.удалить(путь)
	ио.строка("готово")
конец

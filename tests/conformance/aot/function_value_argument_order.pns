функ соединить(лево: Целое, право: Целое) -> Целое
	лево * 10 + право
конец

функ применить(ф: функ(Целое, Целое) -> Целое, лево: Целое, право: Целое) -> Целое
	ф(лево, право)
конец

функ старт() -> Целое
	пер i: Целое = 0
	пер результат: Целое = 0
	пока i < 10000 цикл
		результат = применить(соединить, 2, 7)
		i = i + 1
	конец
	результат
конец

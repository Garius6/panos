    {
      "id": "native-file-roundtrip",
      "tier": "native",
      "profile": "native",
      "input": "tests/integration/native/file_roundtrip.pns",
      "expected": {
        "status": "success",
        "exit_code": 0,
        "stdout": "панос-интеграция",
        "result": "панос-интеграция",
        "deviation": {
          "id": "DEV-003",
          "rationale": "This case is Zig-only, not cross-checked against Odin: Zig's resolver.zig makes native builtin modules (фс/ос/сеть/бд/...) ambient/always-in-scope with no импорт required or even accepted through the real module-graph path, while Odin requires an explicit `импорт <модуль>` for the same modules (confirmed: core/resolver.odin has no unconditional builtin-module installer; every native-builtin e2e test in core/e2e_*.odin imports explicitly). This means no single fixture source can run on both toolchains' real CLIs as-is — see T053's progress-report.md entry for the full investigation. Not fixed here: this is a real, foundational, pre-existing simplification from earlier in the migration, not a regression, and Odin is being retired (T058/T059) rather than made to match."
        }
      }
    },

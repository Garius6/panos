функ сумма_до(предел: Число) -> Число
    пер сумма = 0
    пер индекс = 0
    пока индекс < предел цикл
        индекс = индекс + 1
        если индекс == 2 тогда
            продолжить
        иначе
            сумма = сумма + индекс
        конец
    конец
    если сумма > 0 тогда
        возврат сумма
    иначе
        возврат 0
    конец
конец

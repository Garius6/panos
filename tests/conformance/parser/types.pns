/// Точка на плоскости.
экспорт тип Точка = структура
    x: Число
    y: Число
конец

тип Печатаемый = интерфейс
    функ вСтроку() -> Строка
конец

реализация Печатаемый для Точка
    функ вСтроку(это: Точка) -> Строка
        "точка"
    конец
конец

тип Фигура[T] = перечисление
    Точка
    Круг(T)
конец

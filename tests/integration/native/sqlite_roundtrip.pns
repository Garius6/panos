функ создать(соед: Соединение_БД) -> Строка
    выбор соед.выполнить("CREATE TABLE IF NOT EXISTS t (name TEXT)", массив())
        Успех(_) -> вставить(соед)
        Неудача(ошибка) -> "create-ошибка:" + ошибка.сообщение
    конец
конец

функ вставить(соед: Соединение_БД) -> Строка
    выбор соед.выполнить("INSERT INTO t (name) VALUES (?)", массив("панос"))
        Успех(_) -> запросить(соед)
        Неудача(ошибка) -> "insert-ошибка:" + ошибка.сообщение
    конец
конец

функ запросить(соед: Соединение_БД) -> Строка
    выбор соед.запрос("SELECT name FROM t", массив())
        Успех(строки) -> строки[0].получить("name", "?")
        Неудача(ошибка) -> "query-ошибка:" + ошибка.сообщение
    конец
конец

экспорт функ старт() -> Строка
    выбор бд.открыть(".zig-cache/zzz_integration_native_sqlite.tmp")
        Успех(соед) -> создать(соед)
        Неудача(ошибка) -> "open-ошибка:" + ошибка.сообщение
    конец
конец
